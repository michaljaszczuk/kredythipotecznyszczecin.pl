---
interface Props {
  title: string;
  slug: string;
  address: string;
  phone: string;
  rating: number;
  reviewsCount: number;
  category: string;
}

const { title, slug, address, phone, rating, reviewsCount, category } = Astro.props;

function renderStars(rating: number): string {
  const full = Math.floor(rating);
  const half = rating % 1 >= 0.5 ? 1 : 0;
  const empty = 5 - full - half;
  return '★'.repeat(full) + (half ? '½' : '') + '☆'.repeat(empty);
}
---

<article class="listing-card">
  <div class="listing-card-body">
    <div class="listing-header">
      <div class="listing-avatar">
        {title.charAt(0).toUpperCase()}
      </div>
      <div class="listing-info">
        <h3 class="listing-title">
          <a href={`/doradcy/${slug}`}>{title}</a>
        </h3>
        <span class="listing-category">{category || 'Doradca kredytowy'}</span>
      </div>
    </div>

    <div class="listing-details">
      <div class="listing-rating">
        <span class="stars" aria-label={`Ocena ${rating} na 5`}>{renderStars(rating)}</span>
        <span class="rating-value">{rating.toFixed(1)}</span>
        <span class="reviews-count">({reviewsCount} opinii)</span>
      </div>

      <div class="listing-meta">
        {address && (
          <div class="meta-item">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
            <span>{address}</span>
          </div>
        )}
        {phone && (
          <div class="meta-item">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.127.96.362 1.903.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.907.338 1.85.573 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
            <a href={`tel:${phone}`}>{phone}</a>
          </div>
        )}
      </div>
    </div>

    <a href={`/doradcy/${slug}`} class="listing-cta">Zobacz profil</a>
  </div>
</article>

<style>
  .listing-card {
    background: var(--color-bg-card);
    border: 1px solid var(--color-border);
    border-left: 3px solid transparent;
    border-radius: var(--radius);
    overflow: hidden;
    transition: border-color 0.2s, box-shadow 0.2s;
  }
  .listing-card:hover {
    border-left-color: var(--color-primary);
    box-shadow: var(--shadow);
  }
  .listing-card-body { padding: 1.25rem; }

  .listing-header { display: flex; align-items: flex-start; gap: 0.75rem; margin-bottom: 0.75rem; }
  .listing-avatar {
    width: 40px;
    height: 40px;
    border-radius: var(--radius-sm);
    background: var(--color-primary);
    color: #fff;
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: 600;
    font-size: 1rem;
    flex-shrink: 0;
  }
  .listing-info { min-width: 0; }
  .listing-title {
    font-size: 0.95rem;
    font-weight: 600;
    line-height: 1.3;
    margin-bottom: 0.15rem;
  }
  .listing-title a { color: var(--color-text); }
  .listing-title a:hover { color: var(--color-primary); }
  .listing-category {
    font-size: 0.75rem;
    color: var(--color-text-muted);
  }

  .listing-rating {
    display: flex;
    align-items: center;
    gap: 0.35rem;
    margin-bottom: 0.6rem;
  }
  .stars { color: var(--color-star); font-size: 0.9rem; letter-spacing: 0.5px; }
  .rating-value { font-weight: 600; font-size: 0.85rem; }
  .reviews-count { font-size: 0.75rem; color: var(--color-text-muted); }

  .listing-meta { display: flex; flex-direction: column; gap: 0.35rem; margin-bottom: 0.75rem; }
  .meta-item {
    display: flex;
    align-items: flex-start;
    gap: 0.4rem;
    font-size: 0.8rem;
    color: var(--color-text-muted);
  }
  .meta-item svg { flex-shrink: 0; margin-top: 1px; width: 14px; height: 14px; }
  .meta-item a { color: var(--color-text-muted); }
  .meta-item a:hover { color: var(--color-primary); }

  .listing-cta {
    display: inline-block;
    padding: 0.4rem 1rem;
    background: transparent;
    color: var(--color-primary);
    border: 1.5px solid var(--color-primary);
    border-radius: var(--radius-sm);
    font-size: 0.8rem;
    font-weight: 600;
    transition: background 0.2s, color 0.2s;
  }
  .listing-cta:hover { background: var(--color-primary); color: #fff; }
</style>
