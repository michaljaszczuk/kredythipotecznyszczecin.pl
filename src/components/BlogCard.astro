---
interface Props {
  title: string;
  slug: string;
  description: string;
  date: string;
  category: string;
}

const { title, slug, description, date, category } = Astro.props;
---

<article class="blog-card">
  <div class="blog-card-body">
    <span class="blog-category">{category}</span>
    <h3 class="blog-title">
      <a href={`/blog/${slug}`}>{title}</a>
    </h3>
    <p class="blog-excerpt">{description}</p>
    <div class="blog-footer">
      <time datetime={date}>{new Date(date).toLocaleDateString('pl-PL', { year: 'numeric', month: 'long', day: 'numeric' })}</time>
      <a href={`/blog/${slug}`} class="read-more">Czytaj dalej →</a>
    </div>
  </div>
</article>

<style>
  .blog-card {
    background: var(--color-bg-card);
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    overflow: hidden;
    transition: border-color 0.2s;
  }
  .blog-card:hover {
    border-color: var(--color-primary);
  }
  .blog-card-body { padding: 1.25rem; }

  .blog-category {
    display: inline-block;
    background: var(--color-bg-alt);
    color: var(--color-text-muted);
    font-size: 0.7rem;
    font-weight: 600;
    padding: 0.2rem 0.5rem;
    border-radius: var(--radius-sm);
    margin-bottom: 0.6rem;
    letter-spacing: 0.02em;
  }
  .blog-title {
    font-size: 1.1rem;
    font-weight: 600;
    line-height: 1.4;
    margin-bottom: 0.5rem;
  }
  .blog-title a { color: var(--color-text); }
  .blog-title a:hover { color: var(--color-primary); }

  .blog-excerpt {
    font-size: 0.875rem;
    color: var(--color-text-muted);
    line-height: 1.6;
    margin-bottom: 1rem;
  }

  .blog-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }
  .blog-footer time {
    font-size: 0.8rem;
    color: var(--color-text-muted);
  }
  .read-more {
    font-size: 0.875rem;
    font-weight: 500;
  }
</style>
