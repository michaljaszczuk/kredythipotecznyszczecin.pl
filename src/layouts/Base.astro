---
interface Props {
  title: string;
  description?: string;
  canonical?: string;
}

const { title, description = 'Znajdź najlepszego doradcę kredytowego w Szczecinie. Porównaj oferty kredytów hipotecznych, sprawdź opinie i umów się na bezpłatną konsultację.', canonical } = Astro.props;
const fullTitle = title === 'Strona główna' ? 'Kredyt Hipoteczny Szczecin - Doradcy Kredytowi, Porównanie Ofert' : `${title} | Kredyt Hipoteczny Szczecin`;
const pageUrl = canonical || Astro.url.href;
---

<!doctype html>
<html lang="pl">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description" content={description} />
  <title>{fullTitle}</title>
  {canonical && <link rel="canonical" href={canonical} />}
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

  <!-- Open Graph -->
  <meta property="og:type" content="website" />
  <meta property="og:title" content={fullTitle} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={pageUrl} />
  <meta property="og:site_name" content="KredytHipotecznySzczecin.pl" />
  <meta property="og:locale" content="pl_PL" />

  <!-- Twitter Card -->
  <meta name="twitter:card" content="summary" />
  <meta name="twitter:title" content={fullTitle} />
  <meta name="twitter:description" content={description} />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@400;500;600;700&display=swap" rel="stylesheet" />
</head>
<body>
  <header class="site-header">
    <div class="container header-inner">
      <a href="/" class="logo">
        <span class="logo-map" aria-hidden="true"></span>
        <span class="logo-text">Kredyt<span class="logo-highlight">Hipoteczny</span>Szczecin<span class="logo-dot">.pl</span></span>
      </a>
      <nav class="main-nav">
        <button class="nav-toggle" aria-label="Menu" aria-expanded="false">
          <span></span><span></span><span></span>
        </button>
        <ul class="nav-links">
          <li><a href="/">Strona główna</a></li>
          <li><a href="/doradcy">Doradcy</a></li>
          <li><a href="/blog">Blog</a></li>
          <li><a href="/kontakt">Kontakt</a></li>
        </ul>
      </nav>
    </div>
  </header>

  <main>
    <slot />
  </main>

  <footer class="site-footer">
    <div class="container">
      <div class="footer-grid">
        <div class="footer-col">
          <h4>KredytHipotecznySzczecin.pl</h4>
          <p>Niezależny katalog doradców kredytowych w Szczecinie. Porównuj oferty, czytaj opinie, znajdź najlepszy kredyt hipoteczny.</p>
        </div>
        <div class="footer-col">
          <h4>Nawigacja</h4>
          <ul>
            <li><a href="/">Strona główna</a></li>
            <li><a href="/doradcy">Doradcy kredytowi</a></li>
            <li><a href="/blog">Blog</a></li>
            <li><a href="/kontakt">Kontakt</a></li>
          </ul>
        </div>
        <div class="footer-col">
          <h4>Popularne artykuły</h4>
          <ul>
            <li><a href="/blog/kalkulator-kredytu-hipotecznego">Kalkulator kredytu</a></li>
            <li><a href="/blog/refinansowanie-kredytu-hipotecznego">Refinansowanie</a></li>
            <li><a href="/blog/najlepszy-kredyt-hipoteczny">Najlepszy kredyt</a></li>
            <li><a href="/blog/kredyt-hipoteczny-bez-wkladu-wlasnego">Bez wkładu własnego</a></li>
          </ul>
        </div>
      </div>
      <div class="footer-bottom">
        <p>&copy; {new Date().getFullYear()} KredytHipotecznySzczecin.pl — Wszelkie prawa zastrzeżone. | <a href="/polityka-cookies">Polityka Cookies</a></p>
      </div>
    </div>
  </footer>

  <style is:global>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

    :root {
      --color-primary: #0d9488;
      --color-primary-light: #f0fdfa;
      --color-primary-dark: #0f766e;
      --color-accent: #0d9488;
      --color-accent-light: #ccfbf1;
      --color-bg: #ffffff;
      --color-bg-alt: #fafaf9;
      --color-bg-card: #ffffff;
      --color-text: #1c1917;
      --color-text-muted: #78716c;
      --color-border: #e7e5e4;
      --color-star: #d97706;
      --radius: 10px;
      --radius-sm: 6px;
      --shadow-sm: 0 1px 2px rgba(28,25,23,0.04);
      --shadow: 0 1px 3px rgba(28,25,23,0.06), 0 1px 2px rgba(28,25,23,0.04);
      --shadow-md: 0 4px 12px rgba(28,25,23,0.08);
      --shadow-lg: 0 8px 24px rgba(28,25,23,0.1);
      --font: 'Outfit', system-ui, -apple-system, sans-serif;
      --max-width: 1120px;
    }

    html { scroll-behavior: smooth; }
    body {
      font-family: var(--font);
      color: var(--color-text);
      background: var(--color-bg);
      line-height: 1.6;
      -webkit-font-smoothing: antialiased;
    }

    .container { max-width: var(--max-width); margin: 0 auto; padding: 0 1.25rem; }

    a { color: var(--color-primary); text-decoration: none; transition: color 0.2s; }
    a:hover { color: var(--color-primary-dark); }

    img { max-width: 100%; height: auto; }

    /* Header */
    .site-header {
      border-bottom: 1px solid var(--color-border);
      position: sticky;
      top: 0;
      z-index: 100;
      backdrop-filter: blur(12px);
      background: rgba(255,255,255,0.92);
    }
    .header-inner {
      display: flex;
      align-items: center;
      justify-content: space-between;
      height: 60px;
    }
    .logo {
      display: flex;
      align-items: center;
      font-weight: 700;
      font-size: 1rem;
      color: var(--color-text);
      letter-spacing: -0.02em;
    }
    .logo:hover { color: var(--color-text); }
    .logo-highlight { color: var(--color-primary); }
    .logo-dot { color: var(--color-primary); font-weight: 700; }
    .logo-map {
      display: none;
      width: 20px;
      aspect-ratio: 964 / 971;
      background-color: var(--color-primary);
      -webkit-mask-image: url('/szczecin-borders.svg');
      mask-image: url('/szczecin-borders.svg');
      -webkit-mask-repeat: no-repeat;
      mask-repeat: no-repeat;
      -webkit-mask-size: contain;
      mask-size: contain;
      -webkit-mask-position: center;
      mask-position: center;
      flex-shrink: 0;
    }

    .nav-links {
      display: flex;
      list-style: none;
      gap: 2rem;
    }
    .nav-links a {
      color: var(--color-text-muted);
      font-weight: 500;
      font-size: 0.875rem;
      padding: 0.25rem 0;
      transition: color 0.2s;
    }
    .nav-links a:hover {
      color: var(--color-text);
    }

    .nav-toggle {
      display: none;
      flex-direction: column;
      gap: 5px;
      background: none;
      border: none;
      cursor: pointer;
      padding: 4px;
    }
    .nav-toggle span {
      display: block;
      width: 24px;
      height: 2px;
      background: var(--color-text);
      border-radius: 2px;
      transition: transform 0.3s;
    }

    @media (max-width: 768px) {
      .logo-map { display: block; margin-right: 0.4rem; }
      .nav-toggle { display: flex; }
      .nav-links {
        display: none;
        position: absolute;
        top: 64px;
        left: 0;
        right: 0;
        background: var(--color-bg);
        flex-direction: column;
        padding: 1rem 1.25rem;
        gap: 0;
        border-bottom: 1px solid var(--color-border);
        box-shadow: var(--shadow-md);
      }
      .nav-links.open { display: flex; }
      .nav-links li { padding: 0.75rem 0; border-bottom: 1px solid var(--color-border); }
      .nav-links li:last-child { border-bottom: none; }
    }

    /* Footer */
    .site-footer {
      background: #292524;
      color: #d6d3d1;
      padding: 3rem 0 1.5rem;
      margin-top: 4rem;
    }
    .footer-grid {
      display: grid;
      grid-template-columns: 2fr 1fr 1fr;
      gap: 2rem;
    }
    .footer-col h4 {
      font-size: 0.85rem;
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: 0.04em;
      margin-bottom: 0.75rem;
      color: #fafaf9;
    }
    .footer-col p {
      font-size: 0.85rem;
      color: #a8a29e;
      line-height: 1.7;
    }
    .footer-col ul { list-style: none; }
    .footer-col ul li { margin-bottom: 0.35rem; }
    .footer-col ul a {
      font-size: 0.85rem;
      color: #a8a29e;
    }
    .footer-col ul a:hover { color: #fafaf9; }
    .footer-bottom {
      margin-top: 2rem;
      padding-top: 1.5rem;
      border-top: 1px solid #44403c;
      text-align: center;
    }
    .footer-bottom p { font-size: 0.8rem; color: #78716c; }
    .footer-bottom a { color: #a8a29e; }
    .footer-bottom a:hover { color: #fafaf9; }

    @media (max-width: 768px) {
      .footer-grid { grid-template-columns: 1fr; gap: 1.5rem; }
    }
  </style>

  <script>
    const toggle = document.querySelector('.nav-toggle');
    const links = document.querySelector('.nav-links');
    if (toggle && links) {
      toggle.addEventListener('click', () => {
        const open = links.classList.toggle('open');
        toggle.setAttribute('aria-expanded', String(open));
      });
    }
  </script>
</body>
</html>
