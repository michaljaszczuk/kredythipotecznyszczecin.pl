---
import Base from './Base.astro';
import Sidebar from '../components/Sidebar.astro';

interface Props {
  title: string;
  description: string;
  date: string;
  category: string;
}

const { title, description, date, category } = Astro.props;
---

<Base title={title} description={description}>
  <section class="page-header">
    <div class="container">
      <nav class="breadcrumb" aria-label="Breadcrumb">
        <a href="/">Strona główna</a> <span>/</span>
        <a href="/blog">Blog</a> <span>/</span>
        <span>{title}</span>
      </nav>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="content-with-sidebar">
        <article class="article-content">
          <header class="article-header">
            <span class="article-category">{category}</span>
            <h1>{title}</h1>
            <div class="article-meta">
              <time datetime={date}>{new Date(date).toLocaleDateString('pl-PL', { year: 'numeric', month: 'long', day: 'numeric' })}</time>
            </div>
          </header>
          <div class="article-body">
            <slot />
          </div>
        </article>
        <Sidebar />
      </div>
    </div>
  </section>
</Base>

<style>
  .page-header {
    background: var(--color-bg-alt);
    padding: 1.5rem 0;
    border-bottom: 1px solid var(--color-border);
  }
  .breadcrumb { font-size: 0.8rem; color: var(--color-text-muted); }
  .breadcrumb a { color: var(--color-text-muted); }
  .breadcrumb a:hover { color: var(--color-primary); }
  .breadcrumb span { margin: 0 0.3rem; }

  .section { padding: 2rem 0; }
  .content-with-sidebar {
    display: grid;
    grid-template-columns: 1fr 340px;
    gap: 2rem;
    align-items: start;
  }

  .article-content {
    background: var(--color-bg-card);
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    padding: 2rem;
  }

  .article-header { margin-bottom: 2rem; padding-bottom: 1.5rem; border-bottom: 1px solid var(--color-border); }
  .article-category {
    display: inline-block;
    background: var(--color-primary-light);
    color: var(--color-primary);
    font-size: 0.75rem;
    font-weight: 600;
    padding: 0.2rem 0.6rem;
    border-radius: 100px;
    margin-bottom: 0.75rem;
  }
  .article-header h1 { font-size: 1.75rem; line-height: 1.3; margin-bottom: 0.75rem; }
  .article-meta { font-size: 0.85rem; color: var(--color-text-muted); }

  .article-body :global(h2) { font-size: 1.35rem; margin-top: 2rem; margin-bottom: 0.75rem; }
  .article-body :global(h3) { font-size: 1.1rem; margin-top: 1.5rem; margin-bottom: 0.5rem; }
  .article-body :global(p) { color: var(--color-text-muted); line-height: 1.8; margin-bottom: 1rem; }
  .article-body :global(ul), .article-body :global(ol) {
    margin-bottom: 1rem;
    padding-left: 1.5rem;
    color: var(--color-text-muted);
    line-height: 1.8;
  }
  .article-body :global(li) { margin-bottom: 0.3rem; }
  .article-body :global(strong) { color: var(--color-text); }
  .article-body :global(a) { color: var(--color-primary); text-decoration: underline; }

  .article-body :global(.placeholder-notice) {
    background: var(--color-primary-light);
    border: 1px dashed var(--color-primary);
    border-radius: var(--radius-sm);
    padding: 1.5rem;
    text-align: center;
    color: var(--color-primary);
    font-weight: 500;
    margin: 1.5rem 0;
  }

  @media (max-width: 1024px) { .content-with-sidebar { grid-template-columns: 1fr; } }
  @media (max-width: 768px) { .article-content { padding: 1.25rem; } }
</style>
