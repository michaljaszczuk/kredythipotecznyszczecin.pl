---
import Base from '../layouts/Base.astro';
import ListingCard from '../components/ListingCard.astro';
import Sidebar from '../components/Sidebar.astro';
import FAQ from '../components/FAQ.astro';
import listings from '../data/listings.json';

function slugify(text: string): string {
  return text
    .toLowerCase()
    .normalize('NFD').replace(/[̀-ͯ]/g, '')
    .replace(/ł/g, 'l')
    .replace(/[^a-z0-9]+/g, '-')
    .replace(/(^-|-$)/g, '')
    .substring(0, 80);
}

const topListings = [...listings]
  .sort((a, b) => (b.reviews_count || 0) - (a.reviews_count || 0))
  .slice(0, 6);
---

<Base title="Strona główna">
  <section class="hero">
    <div class="container">
      <div class="hero-layout">
        <div class="hero-content">
          <h1>Znajdź najlepszego <span class="highlight">doradcę kredytowego</span> w&nbsp;Szczecinie</h1>
          <p class="hero-subtitle">Porównaj {listings.length} sprawdzonych doradców. Sprawdź opinie, porównaj oferty i umów bezpłatną konsultację.</p>
          <div class="hero-actions">
            <a href="/doradcy" class="btn btn-primary">Przeglądaj doradców</a>
            <a href="/blog/kalkulator-kredytu-hipotecznego" class="btn btn-ghost">Kalkulator kredytu</a>
          </div>
        </div>
        <div class="hero-stats-panel">
          <div class="stat">
            <span class="stat-value">{listings.length}</span>
            <span class="stat-label">doradców w katalogu</span>
          </div>
          <div class="stat">
            <span class="stat-value">{listings.reduce((sum: number, l: any) => sum + (l.reviews_count || 0), 0).toLocaleString('pl-PL')}</span>
            <span class="stat-label">opinii klientów</span>
          </div>
          <div class="stat">
            <span class="stat-value">{(listings.reduce((sum: number, l: any) => sum + (l.rating || 0), 0) / listings.length).toFixed(1)}</span>
            <span class="stat-label">średnia ocena</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="content-with-sidebar">
        <div class="main-content">
          <h2 class="section-title">Najlepiej oceniani doradcy kredytowi w Szczecinie</h2>
          <div class="listings-grid">
            {topListings.map((listing: any) => (
              <ListingCard
                title={listing.title}
                slug={slugify(listing.title)}
                address={listing.address}
                phone={listing.phone || ''}
                rating={listing.rating || 0}
                reviewsCount={listing.reviews_count || 0}
                category={listing.category || ''}
              />
            ))}
          </div>
          <div class="section-cta">
            <a href="/doradcy" class="btn btn-outline">Zobacz wszystkich doradców →</a>
          </div>
        </div>
        <Sidebar />
      </div>
    </div>
  </section>

  <section class="section section-alt">
    <div class="container">
      <div class="seo-content">
        <h2>Kredyt hipoteczny w Szczecinie - jak znaleźć najlepszą ofertę?</h2>
        <p>Wybór kredytu hipotecznego to jedna z najważniejszych decyzji finansowych w życiu. W Szczecinie działa kilkudziesięciu niezależnych doradców kredytowych, którzy bezpłatnie porównają dla Ciebie oferty z kilkunastu banków. Nasz katalog pomoże Ci znaleźć sprawdzonego eksperta z najlepszymi opiniami.</p>
        <h3>Dlaczego warto skorzystać z doradcy kredytowego?</h3>
        <ul>
          <li><strong>Bezpłatna usługa</strong> - doradca zarabia prowizję od banku, nie od Ciebie</li>
          <li><strong>Dostęp do wielu banków</strong> - porównanie ofert z 15–20 instytucji naraz</li>
          <li><strong>Oszczędność czasu</strong> - jeden wniosek zamiast wizyt w kilkunastu placówkach</li>
          <li><strong>Lepsze warunki</strong> - doradcy często negocjują niższą marżę niż klient indywidualny</li>
        </ul>
        <h3>Jak wybrać doradcę kredytowego w Szczecinie?</h3>
        <p>Zwróć uwagę na liczbę opinii i średnią ocenę w Google - to najlepszy wskaźnik jakości obsługi. Sprawdź, czy doradca współpracuje z szeroką gamą banków (im więcej, tym lepsze porównanie). W naszym katalogu znajdziesz pełne profile z adresami, telefonami i godzinami pracy.</p>

        <FAQ items={[
          {
            question: "Ile kosztuje doradca kredytowy w Szczecinie?",
            answer: "W zdecydowanej większości przypadków usługa doradcy kredytowego jest <strong>bezpłatna</strong> dla klienta. Doradca zarabia prowizję wypłacaną przez bank po podpisaniu umowy kredytowej. Nieliczni niezależni doradcy pobierają honorarium (1 000–5 000 zł), oferując w zamian pełną niezależność od banków."
          },
          {
            question: "Ile trzeba zarabiać, żeby dostać kredyt hipoteczny w Szczecinie?",
            answer: "Zależy od kwoty kredytu, zobowiązań i liczby osób w gospodarstwie domowym. Orientacyjnie: przy kredycie 300 000 zł potrzebujesz ok. 4 000–5 000 zł netto (singiel), a przy 500 000 zł - ok. 6 500–8 000 zł netto. Każdy bank liczy zdolność inaczej, dlatego warto sprawdzić oferty w kilku instytucjach."
          },
          {
            question: "Jaki wkład własny jest wymagany do kredytu hipotecznego?",
            answer: "Zgodnie z Rekomendacją S KNF wymagane jest <strong>20% wartości nieruchomości</strong>. Większość banków akceptuje też <strong>10%</strong> z ubezpieczeniem niskiego wkładu (UNWW, koszt 0,1–0,2% rocznie). W ramach programu Rodzinny Kredyt Mieszkaniowy możliwe jest uzyskanie kredytu bez wkładu dzięki gwarancji BGK do 100 000 zł."
          },
          {
            question: "Jak długo trwa proces uzyskania kredytu hipotecznego?",
            answer: "Od złożenia kompletnego wniosku do wypłaty środków mija zazwyczaj <strong>4–8 tygodni</strong>. Czas zależy od banku, kompletności dokumentów i obłożenia oddziału. Skorzystanie z doradcy kredytowego przyspiesza proces, ponieważ doradca dba o prawidłowe skompletowanie dokumentów od początku."
          },
          {
            question: "Ile wynosi oprocentowanie kredytu hipotecznego w 2026 roku?",
            answer: "W lipcu 2026 roku oprocentowanie zmienne kredytu hipotecznego wynosi ok. <strong>5,5–6,5%</strong> (WIBOR 3M 3,85% + marża banku 1,6–2,5%). Stopa referencyjna NBP to 3,75%. Najniższe RRSO oferują Pekao SA (ok. 6,03%) i mBank (ok. 6,13%). Warunki ustalane są indywidualnie."
          }
        ]} />
      </div>
    </div>
  </section>
</Base>

<style>
  .hero {
    padding: 4rem 0 3.5rem;
    border-bottom: 1px solid var(--color-border);
  }
  .hero-layout {
    display: grid;
    grid-template-columns: 1fr 280px;
    gap: 3rem;
    align-items: center;
  }
  .hero-content { max-width: 600px; }
  .hero h1 {
    font-size: clamp(1.75rem, 3.5vw, 2.25rem);
    font-weight: 700;
    line-height: 1.2;
    margin-bottom: 1rem;
    letter-spacing: -0.02em;
  }
  .highlight { color: #115e59; }
  .hero-subtitle { font-size: 1rem; color: var(--color-text-muted); margin-bottom: 1.5rem; line-height: 1.7; }
  .hero-actions { display: flex; gap: 0.75rem; flex-wrap: wrap; }

  .btn {
    display: inline-flex;
    align-items: center;
    padding: 0.625rem 1.25rem;
    border-radius: var(--radius-sm);
    font-weight: 600;
    font-size: 0.875rem;
    transition: background 0.2s, color 0.2s, border-color 0.2s;
    border: 1.5px solid transparent;
  }
  .btn-primary { background: var(--color-primary); color: #fff; }
  .btn-primary:hover { background: var(--color-primary-dark); color: #fff; }
  .btn-ghost { background: transparent; color: var(--color-text); border-color: var(--color-border); }
  .btn-ghost:hover { border-color: var(--color-text-muted); color: var(--color-text); }
  .btn-outline { background: transparent; color: var(--color-primary); border-color: var(--color-primary); }
  .btn-outline:hover { background: var(--color-primary); color: #fff; }

  .hero-stats-panel {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    padding: 1.5rem;
    background: var(--color-bg-alt);
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
  }
  .stat { display: flex; flex-direction: column; gap: 0.15rem; }
  .stat-value { font-size: 1.5rem; font-weight: 700; color: var(--color-text); letter-spacing: -0.02em; }
  .stat-label { font-size: 0.8rem; color: var(--color-text-muted); }

  .section { padding: 3rem 0; }
  .section-alt { background: var(--color-bg-alt); }
  .section-title { font-size: 1.35rem; font-weight: 700; margin-bottom: 1.5rem; letter-spacing: -0.01em; }

  .content-with-sidebar {
    display: grid;
    grid-template-columns: 1fr 340px;
    gap: 2rem;
    align-items: start;
  }
  .listings-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
    gap: 1rem;
  }
  .section-cta { text-align: center; margin-top: 2rem; }

  .seo-content { max-width: 800px; }
  .seo-content h2 { font-size: 1.5rem; margin-bottom: 1rem; }
  .seo-content h3 { font-size: 1.15rem; margin-top: 1.5rem; margin-bottom: 0.75rem; }
  .seo-content p { color: var(--color-text-muted); line-height: 1.7; margin-bottom: 1rem; }
  .seo-content ul { list-style: none; margin-bottom: 1rem; }
  .seo-content ul li {
    padding: 0.4rem 0 0.4rem 1.5rem;
    position: relative;
    color: var(--color-text-muted);
    line-height: 1.6;
  }
  .seo-content ul li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.7rem;
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: var(--color-primary);
  }

  @media (max-width: 1024px) {
    .content-with-sidebar { grid-template-columns: 1fr; }
    .hero-layout { grid-template-columns: 1fr; gap: 2rem; }
  }
  @media (max-width: 768px) {
    .hero { padding: 2.5rem 0 2rem; }
    .hero-stats-panel { flex-direction: row; justify-content: space-between; }
    .listings-grid { grid-template-columns: 1fr; }
  }
</style>
